[req]
prompt              = no
distinguished_name  = ca_dn

[ca_dn]
commonName          = MOSubCA1
organizationName    = WARP
countryName         = DE
domainComponent     = MO

[ext]
basicConstraints    = critical,CA:true,pathlen:1
keyUsage            = critical,keyCertSign,cRLSign
subjectKeyIdentifier = hash
