+/**
+ * \brief          Return the certificate selected for the current handshake.
+ *
+ * \param ssl      The SSL context to inspect.
+ *
+ * \return         A borrowed pointer to the server certificate selected for
+ *                 the current handshake, or NULL before selection. The pointer
+ *                 remains valid only while the SSL context and certificate do.
+ */
+const mbedtls_x509_crt *mbedtls_ssl_get_hs_own_cert(
+    const mbedtls_ssl_context *ssl);
+
 /**
