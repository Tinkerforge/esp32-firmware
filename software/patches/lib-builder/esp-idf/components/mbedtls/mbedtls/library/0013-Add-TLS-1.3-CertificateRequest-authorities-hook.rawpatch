--- library/ssl_tls13_server.c
+++ library/ssl_tls13_server.c
@@ -31,6 +31,15 @@ __attribute__((weak)) int mbedtls_ssl_tls13_certificate_authorities_cb(
     return -1;
 }
 
+__attribute__((weak)) int mbedtls_ssl_tls13_write_certificate_authorities_cb(
+    mbedtls_ssl_context *ssl, const unsigned char **data, size_t *data_len)
+{
+    (void) ssl;
+    *data = NULL;
+    *data_len = 0;
+    return -1;
+}
+
 
 static const mbedtls_ssl_ciphersuite_t *ssl_tls13_validate_peer_ciphersuite(
     mbedtls_ssl_context *ssl,
@@ -2827,6 +2837,25 @@ static int ssl_tls13_write_certificate_request_body(mbedtls_ssl_context *ssl,
     }
 
     p += output_len;
+
+    const unsigned char *authorities = NULL;
+    size_t authorities_len = 0;
+    if (mbedtls_ssl_tls13_write_certificate_authorities_cb(
+            ssl, &authorities, &authorities_len) == 0) {
+        if (authorities == NULL || authorities_len < 2 || authorities_len > UINT16_MAX ||
+            MBEDTLS_GET_UINT16_BE(authorities, 0) != authorities_len - 2) {
+            return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;
+        }
+        MBEDTLS_SSL_CHK_BUF_PTR(p, end, 4 + authorities_len);
+        MBEDTLS_PUT_UINT16_BE(MBEDTLS_TLS_EXT_CERT_AUTH, p, 0);
+        MBEDTLS_PUT_UINT16_BE(authorities_len, p, 2);
+        memcpy(p + 4, authorities, authorities_len);
+        p += 4 + authorities_len;
+        ssl->handshake->sent_extensions |= MBEDTLS_SSL_EXT_MASK(CERT_AUTH);
+    }
+    if ((size_t) (p - p_extensions_len - 2) > UINT16_MAX) {
+        return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;
+    }
     MBEDTLS_PUT_UINT16_BE(p - p_extensions_len - 2, p_extensions_len, 0);
 
     *out_len = p - buf;
