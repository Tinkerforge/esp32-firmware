diff --git library/ssl_tls.c library/ssl_tls.c
index 1185b0b283..400bb67e47 100644
--- library/ssl_tls.c
+++ library/ssl_tls.c
@@ -1934,6 +1934,16 @@ int mbedtls_ssl_set_hs_own_cert(mbedtls_ssl_context *ssl,
                                own_cert, pk_key);
 }
 
+const mbedtls_x509_crt *mbedtls_ssl_get_hs_own_cert(
+    const mbedtls_ssl_context *ssl)
+{
+    if (ssl == NULL || ssl->handshake == NULL ||
+        ssl->handshake->key_cert == NULL) {
+        return NULL;
+    }
+    return ssl->handshake->key_cert->cert;
+}
+
 void mbedtls_ssl_set_hs_ca_chain(mbedtls_ssl_context *ssl,
