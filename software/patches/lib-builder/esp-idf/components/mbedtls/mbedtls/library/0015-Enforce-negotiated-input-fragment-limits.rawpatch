--- library/ssl_tls.c
+++ library/ssl_tls.c
@@ -3259,24 +3259,9 @@
-    /*
-     * The buffer management is broken somewhere resulting in an input buffer
-     * that has the same size as the output buffer. We want to shrink the
-     * output buffer, but can't force a server to only send fragments that
-     * fit in a smaller than default input buffer (not every server supports
-     * negotiating a smaller fragment size), so just return the configured
-     * input buffer size here.
-     */
-    return max_len;
-
     size_t read_mfl;
 
-#if defined(MBEDTLS_SSL_PROTO_TLS1_2)
-    /* Use the configured MFL for the client if we're past SERVER_HELLO_DONE */
-    if (ssl->conf->endpoint == MBEDTLS_SSL_IS_CLIENT &&
-        ssl->state >= MBEDTLS_SSL_SERVER_HELLO_DONE) {
-        return ssl_mfl_code_to_length(ssl->conf->mfl_code);
-    }
-#endif
-
-    if (ssl->session != NULL) {
+    /* NONE is not a negotiated limit. Its conversion uses the minimum of
+     * input/output capacities, which is wrong for asymmetric receivers. */
+    if (ssl->session != NULL &&
+        ssl->session->mfl_code != MBEDTLS_SSL_MAX_FRAG_LEN_NONE) {
         read_mfl = ssl_mfl_code_to_length(ssl->session->mfl_code);
         if (read_mfl < max_len) {
             max_len = read_mfl;
@@ -3287,7 +3268,8 @@
     /* Check if a smaller max length was negotiated */
-    if (ssl->session_in != NULL) {
+    if (ssl->session_in != NULL &&
+        ssl->session_in->mfl_code != MBEDTLS_SSL_MAX_FRAG_LEN_NONE) {
         read_mfl = ssl_mfl_code_to_length(ssl->session_in->mfl_code);
         if (read_mfl < max_len) {
             max_len = read_mfl;
         }
     }
@@ -3294,7 +3276,8 @@
     /* During a handshake, use the value being negotiated */
-    if (ssl->session_negotiate != NULL) {
+    if (ssl->session_negotiate != NULL &&
+        ssl->session_negotiate->mfl_code != MBEDTLS_SSL_MAX_FRAG_LEN_NONE) {
         read_mfl = ssl_mfl_code_to_length(ssl->session_negotiate->mfl_code);
         if (read_mfl < max_len) {
             max_len = read_mfl;
         }
     }
--- library/ssl_misc.h
+++ library/ssl_misc.h
@@ -474,11 +474,14 @@
 static inline size_t mbedtls_ssl_get_input_buflen(const mbedtls_ssl_context *ctx)
 {
+    /* Keep the asymmetric-buffer workaround at the allocation boundary.
+     * Buffer capacity must not override the negotiated protocol limit. */
+    (void) ctx;
 #if defined(MBEDTLS_SSL_DTLS_CONNECTION_ID)
-    return mbedtls_ssl_get_input_max_frag_len(ctx)
+    return MBEDTLS_SSL_IN_CONTENT_LEN
            + MBEDTLS_SSL_HEADER_LEN + MBEDTLS_SSL_PAYLOAD_OVERHEAD
            + MBEDTLS_SSL_CID_IN_LEN_MAX;
 #else
-    return mbedtls_ssl_get_input_max_frag_len(ctx)
+    return MBEDTLS_SSL_IN_CONTENT_LEN
            + MBEDTLS_SSL_HEADER_LEN + MBEDTLS_SSL_PAYLOAD_OVERHEAD;
 #endif
 }
--- library/ssl_msg.c
+++ library/ssl_msg.c
