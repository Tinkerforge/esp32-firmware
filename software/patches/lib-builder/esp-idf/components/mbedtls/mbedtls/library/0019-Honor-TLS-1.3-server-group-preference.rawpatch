--- library/ssl_tls13_server.c
+++ library/ssl_tls13_server.c
@@ -898,2 +898,19 @@
+/* Return whether candidate precedes current in the configured server order.
+ * A zero current value means that no mutual group has been selected yet. */
+static int ssl_tls13_group_is_preferred(mbedtls_ssl_context *ssl,
+                                      uint16_t candidate, uint16_t current)
+{
+    const uint16_t *groups = mbedtls_ssl_get_groups(ssl);
+    for (; groups != NULL && *groups != 0; groups++) {
+        if (*groups == candidate) {
+            return 1;
+        }
+        if (*groups == current) {
+            return 0;
+        }
+    }
+    return 0;
+}
+
 MBEDTLS_CHECK_RETURN_CRITICAL
 static int ssl_tls13_parse_supported_groups_ext(mbedtls_ssl_context *ssl,
@@ -926,3 +943,4 @@
         if (!mbedtls_ssl_named_group_is_offered(ssl, named_group) ||
             !mbedtls_ssl_named_group_is_supported(named_group) ||
-            ssl->handshake->hrr_selected_group != 0) {
+            !ssl_tls13_group_is_preferred(
+                ssl, named_group, ssl->handshake->hrr_selected_group)) {
@@ -950,2 +968,3 @@
- *  extension is correct and stores the first acceptable key share and its
- *  associated group.
+ *  extension is correct and stores the server-preferred mutual group's share.
+ *  Run after supported_groups, independently of extension wire order. If that
+ *  group's share is absent, request it with HelloRetryRequest.
@@ -1014,3 +1033,4 @@
         if (!mbedtls_ssl_named_group_is_offered(ssl, group) ||
             !mbedtls_ssl_named_group_is_supported(group) ||
+            group != ssl->handshake->hrr_selected_group ||
             ssl->handshake->offered_group_id != 0) {
@@ -1351,1 +1371,5 @@
     int no_usable_share_for_key_agreement = 0;
+#if defined(MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_SOME_EPHEMERAL_ENABLED)
+    const unsigned char *key_share_ext = NULL;
+    const unsigned char *key_share_ext_end = NULL;
+#endif
@@ -1668,12 +1692,4 @@
-                ret = ssl_tls13_parse_key_shares_ext(
-                    ssl, p, extension_data_end);
-                if (ret == SSL_TLS1_3_PARSE_KEY_SHARES_EXT_NO_MATCH) {
-                    MBEDTLS_SSL_DEBUG_MSG(2, ("No usable share for key agreement."));
-                    no_usable_share_for_key_agreement = 1;
-                }
-
-                if (ret < 0) {
-                    MBEDTLS_SSL_DEBUG_RET(
-                        1, "ssl_tls13_parse_key_shares_ext", ret);
-                    return ret;
-                }
+                /* supported_groups may occur later in the ClientHello. */
+                key_share_ext = p;
+                key_share_ext_end = extension_data_end;
+
@@ -1836,2 +1852,16 @@
+#if defined(MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_SOME_EPHEMERAL_ENABLED)
+    if (key_share_ext != NULL) {
+        ret = ssl_tls13_parse_key_shares_ext(
+            ssl, key_share_ext, key_share_ext_end);
+        if (ret == SSL_TLS1_3_PARSE_KEY_SHARES_EXT_NO_MATCH) {
+            no_usable_share_for_key_agreement = 1;
+        } else if (ret < 0) {
+            MBEDTLS_SSL_DEBUG_RET(1, "ssl_tls13_parse_key_shares_ext", ret);
+            return ret;
+        }
+    }
+#endif
+
+
     MBEDTLS_SSL_PRINT_EXTS(3, MBEDTLS_SSL_HS_CLIENT_HELLO,
                            handshake->received_extensions);
@@ -1932,1 +1962,9 @@
+#if defined(MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_SOME_EPHEMERAL_ENABLED)
+        if (handshake->hrr_selected_group == 0) {
+            MBEDTLS_SSL_PEND_FATAL_ALERT(
+                MBEDTLS_SSL_ALERT_MSG_HANDSHAKE_FAILURE,
+                MBEDTLS_ERR_SSL_HANDSHAKE_FAILURE);
+            return MBEDTLS_ERR_SSL_HANDSHAKE_FAILURE;
+        }
+#endif
         hrr_required = (no_usable_share_for_key_agreement != 0);
