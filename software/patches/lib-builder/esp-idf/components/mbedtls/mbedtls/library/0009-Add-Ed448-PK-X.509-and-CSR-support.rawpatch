--- /dev/null
+++ library/pk_ed448.c
@@ -0,0 +1,230 @@
+/*
+ * Ed448 PK wrapper backed by tf_ed448.
+ *
+ * SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later
+ */
+#include "common.h"
+
+#if defined(MBEDTLS_PK_C) && defined(MBEDTLS_ED448_C)
+
+#include "mbedtls/ed448.h"
+#include "mbedtls/pk.h"
+#include "mbedtls/platform.h"
+#include "mbedtls/platform_util.h"
+#include "pk_wrap.h"
+
+#include <string.h>
+
+/* Narrow provider ABI. The final application overrides these weak defaults. */
+#define TF_ED448_SUCCESS 0
+#define TF_ED448_OUT_OF_MEMORY -5
+int tf_ed448_derive_public(const unsigned char *a, size_t b,
+                           unsigned char *c, size_t d);
+int tf_ed448_validate_public(const unsigned char *a, size_t b);
+int tf_ed448_sign(const unsigned char *a, size_t b,
+                  const unsigned char *c, size_t d,
+                  const unsigned char *e, size_t f,
+                  unsigned char *g, size_t h);
+int tf_ed448_verify(const unsigned char *a, size_t b,
+                    const unsigned char *c, size_t d,
+                    const unsigned char *e, size_t f);
+
+__attribute__((weak)) int tf_ed448_derive_public(const unsigned char *a, size_t b,
+                                                 unsigned char *c, size_t d)
+{ (void) a; (void) b; (void) c; (void) d; return -1; }
+__attribute__((weak)) int tf_ed448_validate_public(const unsigned char *a, size_t b)
+{ (void) a; (void) b; return -1; }
+__attribute__((weak)) int tf_ed448_sign(const unsigned char *a, size_t b,
+                                        const unsigned char *c, size_t d,
+                                        const unsigned char *e, size_t f,
+                                        unsigned char *g, size_t h)
+{ (void) a; (void) b; (void) c; (void) d; (void) e; (void) f; (void) g; (void) h; return -1; }
+__attribute__((weak)) int tf_ed448_verify(const unsigned char *a, size_t b,
+                                          const unsigned char *c, size_t d,
+                                          const unsigned char *e, size_t f)
+{ (void) a; (void) b; (void) c; (void) d; (void) e; (void) f; return -1; }
+
+void mbedtls_ed448_init(mbedtls_ed448_context *ctx)
+{
+    memset(ctx, 0, sizeof(*ctx));
+}
+
+void mbedtls_ed448_free(mbedtls_ed448_context *ctx)
+{
+    if (ctx != NULL) {
+        mbedtls_platform_zeroize(ctx, sizeof(*ctx));
+    }
+}
+
+int mbedtls_ed448_import_public(mbedtls_ed448_context *ctx,
+                                const unsigned char *public_key,
+                                size_t public_key_len)
+{
+    if (ctx == NULL || tf_ed448_validate_public(public_key, public_key_len) !=
+                           TF_ED448_SUCCESS) {
+        return MBEDTLS_ERR_PK_INVALID_PUBKEY;
+    }
+    memcpy(ctx->MBEDTLS_PRIVATE(public_key), public_key, public_key_len);
+    ctx->MBEDTLS_PRIVATE(has_public) = 1;
+    return 0;
+}
+
+int mbedtls_ed448_import_private(mbedtls_ed448_context *ctx,
+                                 const unsigned char *private_seed,
+                                 size_t private_seed_len)
+{
+    if (ctx == NULL || private_seed == NULL ||
+        private_seed_len != MBEDTLS_ED448_PRIVATE_KEY_SIZE) {
+        return MBEDTLS_ERR_PK_INVALID_PUBKEY;
+    }
+    if (private_seed != ctx->MBEDTLS_PRIVATE(private_seed)) {
+        memcpy(ctx->MBEDTLS_PRIVATE(private_seed), private_seed, private_seed_len);
+    }
+    if (tf_ed448_derive_public(ctx->MBEDTLS_PRIVATE(private_seed), private_seed_len,
+                              ctx->MBEDTLS_PRIVATE(public_key),
+                              MBEDTLS_ED448_PUBLIC_KEY_SIZE) != TF_ED448_SUCCESS) {
+        mbedtls_ed448_free(ctx);
+        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;
+    }
+    ctx->MBEDTLS_PRIVATE(has_private) = 1;
+    ctx->MBEDTLS_PRIVATE(has_public) = 1;
+    return 0;
+}
+
+int mbedtls_ed448_gen_key(mbedtls_ed448_context *ctx,
+                          int (*f_rng)(void *, unsigned char *, size_t),
+                          void *p_rng)
+{
+    if (ctx == NULL || f_rng == NULL ||
+        f_rng(p_rng, ctx->MBEDTLS_PRIVATE(private_seed),
+              MBEDTLS_ED448_PRIVATE_KEY_SIZE) != 0) {
+        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;
+    }
+    return mbedtls_ed448_import_private(ctx, ctx->MBEDTLS_PRIVATE(private_seed),
+                                        MBEDTLS_ED448_PRIVATE_KEY_SIZE);
+}
+
+static size_t ed448_get_bitlen(mbedtls_pk_context *pk)
+{
+    (void) pk;
+    return 448;
+}
+
+static int ed448_can_do(mbedtls_pk_type_t type)
+{
+    return type == MBEDTLS_PK_ED448;
+}
+
+static int ed448_verify_wrap(mbedtls_pk_context *pk, mbedtls_md_type_t md_alg,
+                             const unsigned char *message, size_t message_len,
+                             const unsigned char *sig, size_t sig_len)
+{
+    mbedtls_ed448_context *ctx = mbedtls_pk_ed448(*pk);
+    if (ctx == NULL || md_alg != MBEDTLS_MD_NONE ||
+        ctx->MBEDTLS_PRIVATE(has_public) == 0 || sig == NULL ||
+        sig_len < MBEDTLS_ED448_SIGNATURE_SIZE) {
+        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;
+    }
+    int ret = tf_ed448_verify(ctx->MBEDTLS_PRIVATE(public_key),
+                              MBEDTLS_ED448_PUBLIC_KEY_SIZE, message, message_len,
+                              sig, MBEDTLS_ED448_SIGNATURE_SIZE);
+    if (ret == TF_ED448_OUT_OF_MEMORY) {
+        return MBEDTLS_ERR_PK_ALLOC_FAILED;
+    }
+    if (ret != TF_ED448_SUCCESS) {
+        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;
+    }
+    return sig_len == MBEDTLS_ED448_SIGNATURE_SIZE
+               ? 0
+               : MBEDTLS_ERR_PK_SIG_LEN_MISMATCH;
+}
+
+static int ed448_sign_wrap(mbedtls_pk_context *pk, mbedtls_md_type_t md_alg,
+                           const unsigned char *message, size_t message_len,
+                           unsigned char *sig, size_t sig_size, size_t *sig_len,
+                           int (*f_rng)(void *, unsigned char *, size_t), void *p_rng)
+{
+    mbedtls_ed448_context *ctx = mbedtls_pk_ed448(*pk);
+    (void) f_rng;
+    (void) p_rng;
+    if (ctx == NULL || md_alg != MBEDTLS_MD_NONE || sig == NULL || sig_len == NULL ||
+        sig_size < MBEDTLS_ED448_SIGNATURE_SIZE ||
+        ctx->MBEDTLS_PRIVATE(has_private) == 0 ||
+        ctx->MBEDTLS_PRIVATE(has_public) == 0) {
+        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;
+    }
+    if (tf_ed448_sign(ctx->MBEDTLS_PRIVATE(private_seed),
+                      MBEDTLS_ED448_PRIVATE_KEY_SIZE,
+                      ctx->MBEDTLS_PRIVATE(public_key),
+                      MBEDTLS_ED448_PUBLIC_KEY_SIZE,
+                      message, message_len, sig, MBEDTLS_ED448_SIGNATURE_SIZE) !=
+        TF_ED448_SUCCESS) {
+        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;
+    }
+    *sig_len = MBEDTLS_ED448_SIGNATURE_SIZE;
+    return 0;
+}
+
+static int ed448_check_pair_wrap(mbedtls_pk_context *pub, mbedtls_pk_context *prv,
+                                 int (*f_rng)(void *, unsigned char *, size_t),
+                                 void *p_rng)
+{
+    mbedtls_ed448_context *pub_ctx = mbedtls_pk_ed448(*pub);
+    mbedtls_ed448_context *prv_ctx = mbedtls_pk_ed448(*prv);
+    unsigned char derived[MBEDTLS_ED448_PUBLIC_KEY_SIZE];
+    int ret = MBEDTLS_ERR_PK_BAD_INPUT_DATA;
+    (void) f_rng;
+    (void) p_rng;
+    if (pub_ctx != NULL && prv_ctx != NULL &&
+        pub_ctx->MBEDTLS_PRIVATE(has_public) != 0 &&
+        prv_ctx->MBEDTLS_PRIVATE(has_private) != 0 &&
+        tf_ed448_derive_public(prv_ctx->MBEDTLS_PRIVATE(private_seed),
+                              MBEDTLS_ED448_PRIVATE_KEY_SIZE,
+                              derived, sizeof(derived)) == TF_ED448_SUCCESS &&
+        memcmp(derived, pub_ctx->MBEDTLS_PRIVATE(public_key), sizeof(derived)) == 0) {
+        ret = 0;
+    }
+    mbedtls_platform_zeroize(derived, sizeof(derived));
+    return ret;
+}
+
+static void *ed448_alloc_wrap(void)
+{
+    mbedtls_ed448_context *ctx = mbedtls_calloc(1, sizeof(*ctx));
+    if (ctx != NULL) {
+        mbedtls_ed448_init(ctx);
+    }
+    return ctx;
+}
+
+static void ed448_free_wrap(void *opaque)
+{
+    mbedtls_ed448_context *ctx = opaque;
+    mbedtls_ed448_free(ctx);
+    mbedtls_free(ctx);
+}
+
+const mbedtls_pk_info_t mbedtls_ed448_info = {
+    .type = MBEDTLS_PK_ED448,
+    .name = "Ed448",
+    .get_bitlen = ed448_get_bitlen,
+    .can_do = ed448_can_do,
+    .verify_func = ed448_verify_wrap,
+    .sign_func = ed448_sign_wrap,
+#if defined(MBEDTLS_ECDSA_C) && defined(MBEDTLS_ECP_RESTARTABLE)
+    .verify_rs_func = NULL,
+    .sign_rs_func = NULL,
+#endif
+    .decrypt_func = NULL,
+    .encrypt_func = NULL,
+    .check_pair_func = ed448_check_pair_wrap,
+    .ctx_alloc_func = ed448_alloc_wrap,
+    .ctx_free_func = ed448_free_wrap,
+#if defined(MBEDTLS_ECDSA_C) && defined(MBEDTLS_ECP_RESTARTABLE)
+    .rs_alloc_func = NULL,
+    .rs_free_func = NULL,
+#endif
+    .debug_func = NULL,
+};
+
+#endif
