@@ -567,6 +574,15 @@ int mbedtls_pk_parse_subpubkey(unsigned char **p, const unsigned char *end,
         }
     } else
 #endif /* MBEDTLS_RSA_C */
+#if defined(MBEDTLS_ED448_C)
+    if (pk_alg == MBEDTLS_PK_ED448) {
+        ret = mbedtls_ed448_import_public(mbedtls_pk_ed448(*pk), *p,
+                                          (size_t) (end - *p));
+        if (ret == 0) {
+            *p = (unsigned char *) end;
+        }
+    } else
