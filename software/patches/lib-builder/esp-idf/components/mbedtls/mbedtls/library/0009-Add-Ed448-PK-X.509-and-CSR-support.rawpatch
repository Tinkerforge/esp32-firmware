@@ -597,6 +613,21 @@ int mbedtls_pk_parse_subpubkey(unsigned char **p, const unsigned char *end,
     return ret;
 }
 
+#if defined(MBEDTLS_ED448_C)
+static int pk_parse_key_ed448_der(mbedtls_pk_context *pk,
+                                  unsigned char *key, size_t keylen)
+{
+    unsigned char *p = key;
+    const unsigned char *end = key + keylen;
+    size_t len;
+    int ret = mbedtls_asn1_get_tag(&p, end, &len, MBEDTLS_ASN1_OCTET_STRING);
+    if (ret != 0 || len != MBEDTLS_ED448_PRIVATE_KEY_SIZE || p + len != end) {
+        return MBEDTLS_ERR_PK_KEY_INVALID_FORMAT;
+    }
+    return mbedtls_ed448_import_private(mbedtls_pk_ed448(*pk), p, len);
+}
+#endif
+
 #if defined(MBEDTLS_PK_HAVE_ECC_KEYS)
 /*
  * Parse a SEC1 encoded private EC key
@@ -818,6 +849,14 @@ static int pk_parse_key_pkcs8_unencrypted_der(
         }
     } else
 #endif /* MBEDTLS_RSA_C */
+#if defined(MBEDTLS_ED448_C)
+    if (pk_alg == MBEDTLS_PK_ED448) {
+        if ((ret = pk_parse_key_ed448_der(pk, p, len)) != 0) {
+            mbedtls_pk_free(pk);
+            return ret;
+        }
+    } else
+#endif
 #if defined(MBEDTLS_PK_HAVE_ECC_KEYS)
     if (pk_alg == MBEDTLS_PK_ECKEY || pk_alg == MBEDTLS_PK_ECKEY_DH) {
 #if defined(MBEDTLS_PK_HAVE_RFC8410_CURVES)
diff --git library/pkwrite.c library/pkwrite.c
index d264abfbd9..f3147db512 100644
--- library/pkwrite.c
+++ library/pkwrite.c
@@ -26,7 +26,7 @@
 #if defined(MBEDTLS_PK_HAVE_ECC_KEYS)
 #include "pk_internal.h"
 #endif
-#if defined(MBEDTLS_RSA_C) || defined(MBEDTLS_PK_HAVE_ECC_KEYS)
+#if defined(MBEDTLS_RSA_C) || defined(MBEDTLS_PK_HAVE_ECC_KEYS) || defined(MBEDTLS_ED448_C)
 #include "pkwrite.h"
 #endif
 #if defined(MBEDTLS_PEM_WRITE_C)
@@ -42,6 +42,42 @@
 #endif
 #include "mbedtls/platform.h"
 
+#if defined(MBEDTLS_ED448_C)
+static int pk_write_ed448_pubkey(unsigned char **p, unsigned char *start,
+                                 const mbedtls_pk_context *pk)
+{
+    const mbedtls_ed448_context *ctx = mbedtls_pk_ed448(*pk);
+    if (ctx == NULL || ctx->MBEDTLS_PRIVATE(has_public) == 0) {
+        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;
+    }
+    return mbedtls_asn1_write_raw_buffer(
+        p, start, ctx->MBEDTLS_PRIVATE(public_key), MBEDTLS_ED448_PUBLIC_KEY_SIZE);
+}
+
+static int pk_write_ed448_der(unsigned char **p, unsigned char *start,
+                              const mbedtls_pk_context *pk)
+{
+    int ret;
+    size_t inner_len = 0, len = 0;
+    const mbedtls_ed448_context *ctx = mbedtls_pk_ed448(*pk);
+    if (ctx == NULL || ctx->MBEDTLS_PRIVATE(has_private) == 0) {
+        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;
+    }
+    MBEDTLS_ASN1_CHK_ADD(inner_len, mbedtls_asn1_write_octet_string(
+        p, start, ctx->MBEDTLS_PRIVATE(private_seed), MBEDTLS_ED448_PRIVATE_KEY_SIZE));
+    len = inner_len;
+    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(p, start, inner_len));
+    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_tag(p, start, MBEDTLS_ASN1_OCTET_STRING));
+    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_algorithm_identifier_ext(
+        p, start, MBEDTLS_OID_ED448, MBEDTLS_OID_SIZE(MBEDTLS_OID_ED448), 0, 0));
+    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_int(p, start, 0));
+    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(p, start, len));
+    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_tag(
+        p, start, MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE));
+    return (int) len;
+}
+#endif
+
 /* Helpers for properly sizing buffers aimed at holding public keys or
  * key-pairs based on build symbols. */
 #if defined(MBEDTLS_PK_USE_PSA_EC_DATA)
@@ -429,6 +465,11 @@ int mbedtls_pk_write_pubkey(unsigned char **p, unsigned char *start,
         MBEDTLS_ASN1_CHK_ADD(len, mbedtls_rsa_write_pubkey(mbedtls_pk_rsa(*key), start, p));
     } else
 #endif
+#if defined(MBEDTLS_ED448_C)
+    if (mbedtls_pk_get_type(key) == MBEDTLS_PK_ED448) {
+        MBEDTLS_ASN1_CHK_ADD(len, pk_write_ed448_pubkey(p, start, key));
+    } else
+#endif
 #if defined(MBEDTLS_PK_HAVE_ECC_KEYS)
     if (mbedtls_pk_get_type(key) == MBEDTLS_PK_ECKEY) {
         MBEDTLS_ASN1_CHK_ADD(len, pk_write_ec_pubkey(p, start, key));
@@ -478,6 +519,12 @@ int mbedtls_pk_write_pubkey_der(const mbedtls_pk_context *key, unsigned char *bu
 
     pk_type = pk_get_type_ext(key);
 
+#if defined(MBEDTLS_ED448_C)
+    if (pk_type == MBEDTLS_PK_ED448) {
+        has_par = 0;
+    }
+#endif
+
 #if defined(MBEDTLS_PK_HAVE_ECC_KEYS)
     if (pk_get_type_ext(key) == MBEDTLS_PK_ECKEY) {
         mbedtls_ecp_group_id ec_grp_id = mbedtls_pk_get_ec_group_id(key);
@@ -526,6 +573,11 @@ int mbedtls_pk_write_key_der(const mbedtls_pk_context *key, unsigned char *buf,
         return pk_write_rsa_der(&c, buf, key);
     } else
 #endif /* MBEDTLS_RSA_C */
+#if defined(MBEDTLS_ED448_C)
+    if (pk_get_type_ext(key) == MBEDTLS_PK_ED448) {
+        return pk_write_ed448_der(&c, buf, key);
+    } else
+#endif
 #if defined(MBEDTLS_PK_HAVE_ECC_KEYS)
     if (pk_get_type_ext(key) == MBEDTLS_PK_ECKEY) {
 #if defined(MBEDTLS_PK_HAVE_RFC8410_CURVES)
@@ -544,12 +596,13 @@ int mbedtls_pk_write_key_der(const mbedtls_pk_context *key, unsigned char *buf,
  ******************************************************************************/
 #if defined(MBEDTLS_PEM_WRITE_C)
 
-#define PUB_DER_MAX_BYTES                                                   \
-    (MBEDTLS_PK_RSA_PUB_DER_MAX_BYTES > MBEDTLS_PK_ECP_PUB_DER_MAX_BYTES ? \
-     MBEDTLS_PK_RSA_PUB_DER_MAX_BYTES : MBEDTLS_PK_ECP_PUB_DER_MAX_BYTES)
+#define PUB_DER_MAX_BYTES MBEDTLS_PK_WRITE_PUBKEY_MAX_SIZE
 #define PRV_DER_MAX_BYTES                                                   \
-    (MBEDTLS_PK_RSA_PRV_DER_MAX_BYTES > MBEDTLS_PK_ECP_PRV_DER_MAX_BYTES ? \
-     MBEDTLS_PK_RSA_PRV_DER_MAX_BYTES : MBEDTLS_PK_ECP_PRV_DER_MAX_BYTES)
+    (MBEDTLS_PK_RSA_PRV_DER_MAX_BYTES > MBEDTLS_PK_ECP_PRV_DER_MAX_BYTES   \
+         ? (MBEDTLS_PK_RSA_PRV_DER_MAX_BYTES > MBEDTLS_PK_ED448_PRV_DER_MAX_BYTES \
+                ? MBEDTLS_PK_RSA_PRV_DER_MAX_BYTES : MBEDTLS_PK_ED448_PRV_DER_MAX_BYTES) \
+         : (MBEDTLS_PK_ECP_PRV_DER_MAX_BYTES > MBEDTLS_PK_ED448_PRV_DER_MAX_BYTES \
+                ? MBEDTLS_PK_ECP_PRV_DER_MAX_BYTES : MBEDTLS_PK_ED448_PRV_DER_MAX_BYTES))
 
 int mbedtls_pk_write_pubkey_pem(const mbedtls_pk_context *key, unsigned char *buf, size_t size)
 {
@@ -599,6 +652,12 @@ int mbedtls_pk_write_key_pem(const mbedtls_pk_context *key, unsigned char *buf,
         end = PEM_END_PRIVATE_KEY_RSA "\n";
     } else
 #endif
+#if defined(MBEDTLS_ED448_C)
+    if (pk_get_type_ext(key) == MBEDTLS_PK_ED448) {
+        begin = PEM_BEGIN_PRIVATE_KEY_PKCS8 "\n";
+        end = PEM_END_PRIVATE_KEY_PKCS8 "\n";
+    } else
+#endif
 #if defined(MBEDTLS_PK_HAVE_ECC_KEYS)
     if (pk_get_type_ext(key) == MBEDTLS_PK_ECKEY) {
         if (mbedtls_pk_is_rfc8410(key)) {
diff --git library/pkwrite.h library/pkwrite.h
index 01dc3d2f0f..ca4d2920b5 100644
--- library/pkwrite.h
+++ library/pkwrite.h
@@ -110,12 +110,21 @@
 
 #endif /* MBEDTLS_PK_HAVE_ECC_KEYS */
 
-/* Define the maximum available public key DER length based on the supported
- * key types (EC and/or RSA). */
-#if (MBEDTLS_PK_RSA_PUB_DER_MAX_BYTES > MBEDTLS_PK_ECP_PUB_DER_MAX_BYTES)
-#define MBEDTLS_PK_WRITE_PUBKEY_MAX_SIZE    MBEDTLS_PK_RSA_PUB_DER_MAX_BYTES
+#if defined(MBEDTLS_ED448_C)
+#define MBEDTLS_PK_ED448_PUB_DER_MAX_BYTES 80
+#define MBEDTLS_PK_ED448_PRV_DER_MAX_BYTES 80
 #else
-#define MBEDTLS_PK_WRITE_PUBKEY_MAX_SIZE    MBEDTLS_PK_ECP_PUB_DER_MAX_BYTES
+#define MBEDTLS_PK_ED448_PUB_DER_MAX_BYTES 0
+#define MBEDTLS_PK_ED448_PRV_DER_MAX_BYTES 0
 #endif
 
+/* Define the maximum available public key DER length based on the supported
+ * key types (EC and/or RSA). */
+#define MBEDTLS_PK_WRITE_PUBKEY_MAX_SIZE                                  \
+    (MBEDTLS_PK_RSA_PUB_DER_MAX_BYTES > MBEDTLS_PK_ECP_PUB_DER_MAX_BYTES  \
+         ? (MBEDTLS_PK_RSA_PUB_DER_MAX_BYTES > MBEDTLS_PK_ED448_PUB_DER_MAX_BYTES \
+                ? MBEDTLS_PK_RSA_PUB_DER_MAX_BYTES : MBEDTLS_PK_ED448_PUB_DER_MAX_BYTES) \
+         : (MBEDTLS_PK_ECP_PUB_DER_MAX_BYTES > MBEDTLS_PK_ED448_PUB_DER_MAX_BYTES \
+                ? MBEDTLS_PK_ECP_PUB_DER_MAX_BYTES : MBEDTLS_PK_ED448_PUB_DER_MAX_BYTES))
+
 #endif /* MBEDTLS_PK_WRITE_H */
