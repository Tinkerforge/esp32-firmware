--- library/ssl_misc.h
+++ library/ssl_misc.h
@@ -654,2 +654,2 @@
-#if defined(MBEDTLS_SSL_PROTO_TLS1_3) && \
-    (defined(MBEDTLS_SSL_MAX_FRAGMENT_LENGTH) || defined(MBEDTLS_SSL_RECORD_SIZE_LIMIT))
+#if defined(MBEDTLS_SSL_MAX_FRAGMENT_LENGTH) || \
+    defined(MBEDTLS_SSL_RECORD_SIZE_LIMIT)
@@ -1507,2 +1507,2 @@
-#if defined(MBEDTLS_SSL_PROTO_TLS1_3) && \
-    (defined(MBEDTLS_SSL_MAX_FRAGMENT_LENGTH) || defined(MBEDTLS_SSL_RECORD_SIZE_LIMIT))
+#if defined(MBEDTLS_SSL_MAX_FRAGMENT_LENGTH) || \
+    defined(MBEDTLS_SSL_RECORD_SIZE_LIMIT)
--- library/ssl_msg.c
+++ library/ssl_msg.c
@@ -2903,6 +2903,8 @@
-#if defined(MBEDTLS_SSL_PROTO_TLS1_3) && \
-    (defined(MBEDTLS_SSL_MAX_FRAGMENT_LENGTH) || defined(MBEDTLS_SSL_RECORD_SIZE_LIMIT))
-        if (ssl->tls_version == MBEDTLS_SSL_VERSION_TLS1_3 &&
-            ssl->transform_out != NULL &&
+#if defined(MBEDTLS_SSL_MAX_FRAGMENT_LENGTH) || \
+    defined(MBEDTLS_SSL_RECORD_SIZE_LIMIT)
+        if (ssl->conf->transport == MBEDTLS_SSL_TRANSPORT_STREAM &&
+            (ssl->tls_version == MBEDTLS_SSL_VERSION_TLS1_2 ||
+             (ssl->tls_version == MBEDTLS_SSL_VERSION_TLS1_3 &&
+              ssl->transform_out != NULL)) &&
             ssl->out_msgtype == MBEDTLS_SSL_MSG_HANDSHAKE) {
             const int max_payload = mbedtls_ssl_get_max_out_record_payload(ssl);
@@ -2922,4 +2924,9 @@
-                /* TLS 1.3 handlers advance state after preparing a message.
-                 * Send it in ssl_prepare_handshake_step, without rerunning
-                 * the handler or hashing/signing the message a second time. */
+                /* TLS 1.2 writers advance state before requesting a flush.
+                 * Preserve their immediate-send behavior; on WANT_WRITE,
+                 * ssl_prepare_handshake_step drains the saved remainder.
+                 * TLS 1.3 handlers advance after preparing the message and
+                 * defer sending to that same handshake preparation phase. */
+                if (force_flush != 0) {
+                    return mbedtls_ssl_flush_handshake_fragments(ssl);
+                }
                 return 0;
@@ -2940,2 +2947,2 @@
-#if defined(MBEDTLS_SSL_PROTO_TLS1_3) && \
-    (defined(MBEDTLS_SSL_MAX_FRAGMENT_LENGTH) || defined(MBEDTLS_SSL_RECORD_SIZE_LIMIT))
+#if defined(MBEDTLS_SSL_MAX_FRAGMENT_LENGTH) || \
+    defined(MBEDTLS_SSL_RECORD_SIZE_LIMIT)
--- library/ssl_tls.c
+++ library/ssl_tls.c
@@ -4584,2 +4584,2 @@
-#if defined(MBEDTLS_SSL_PROTO_TLS1_3) && \
-    (defined(MBEDTLS_SSL_MAX_FRAGMENT_LENGTH) || defined(MBEDTLS_SSL_RECORD_SIZE_LIMIT))
+#if defined(MBEDTLS_SSL_MAX_FRAGMENT_LENGTH) || \
+    defined(MBEDTLS_SSL_RECORD_SIZE_LIMIT)
@@ -4864,2 +4864,2 @@
-#if defined(MBEDTLS_SSL_PROTO_TLS1_3) && \
-    (defined(MBEDTLS_SSL_MAX_FRAGMENT_LENGTH) || defined(MBEDTLS_SSL_RECORD_SIZE_LIMIT))
+#if defined(MBEDTLS_SSL_MAX_FRAGMENT_LENGTH) || \
+    defined(MBEDTLS_SSL_RECORD_SIZE_LIMIT)
