@@ -2913,3 +2940,48 @@
+#if defined(MBEDTLS_SSL_PROTO_TLS1_3) && \
+    (defined(MBEDTLS_SSL_MAX_FRAGMENT_LENGTH) || defined(MBEDTLS_SSL_RECORD_SIZE_LIMIT))
+int mbedtls_ssl_flush_handshake_fragments(mbedtls_ssl_context *ssl)
+{
+    mbedtls_ssl_handshake_params *handshake = ssl->handshake;
+    int ret;
+
+    if (handshake->outgoing_hs == NULL) {
+        return 0;
+    }
+    /* A retry must finish the existing ciphertext before reusing out_msg. */
+    if ((ret = mbedtls_ssl_flush_output(ssl)) != 0) {
+        return ret;
+    }
+    while (handshake->outgoing_hs_offset < handshake->outgoing_hs_len) {
+        const int max_payload = mbedtls_ssl_get_max_out_record_payload(ssl);
+        size_t length = handshake->outgoing_hs_len - handshake->outgoing_hs_offset;
+        if (max_payload <= 0) {
+            return max_payload < 0 ? max_payload : MBEDTLS_ERR_SSL_BAD_INPUT_DATA;
+        }
+        if (length > (size_t) max_payload) {
+            length = (size_t) max_payload;
+        }
+        memcpy(ssl->out_msg, handshake->outgoing_hs + handshake->outgoing_hs_offset,
+               length);
+        ssl->out_msglen = length;
+        ssl->out_msgtype = MBEDTLS_SSL_MSG_HANDSHAKE;
+        /* Queue exactly one record. Advance plaintext only once encryption
+         * succeeds; WANT_WRITE below leaves ciphertext and offset intact. */
+        if ((ret = mbedtls_ssl_write_record(ssl, 0)) != 0) {
+            return ret;
+        }
+        handshake->outgoing_hs_offset += length;
+        if ((ret = mbedtls_ssl_flush_output(ssl)) != 0) {
+            return ret;
+        }
+    }
+    mbedtls_zeroize_and_free(handshake->outgoing_hs, handshake->outgoing_hs_len);
+    handshake->outgoing_hs = NULL;
+    handshake->outgoing_hs_len = 0;
+    handshake->outgoing_hs_offset = 0;
+    return 0;
+}
+#endif
