+            const int max_payload = mbedtls_ssl_get_max_out_record_payload(ssl);
+            if (max_payload <= 0) {
+                return max_payload < 0 ? max_payload : MBEDTLS_ERR_SSL_BAD_INPUT_DATA;
+            }
+            if (ssl->out_msglen > (size_t) max_payload) {
+                if (ssl->handshake->outgoing_hs != NULL) {
+                    return MBEDTLS_ERR_SSL_INTERNAL_ERROR;
+                }
+                ssl->handshake->outgoing_hs = mbedtls_calloc(1, ssl->out_msglen);
+                if (ssl->handshake->outgoing_hs == NULL) {
+                    return MBEDTLS_ERR_SSL_ALLOC_FAILED;
+                }
+                memcpy(ssl->handshake->outgoing_hs, ssl->out_msg, ssl->out_msglen);
+                ssl->handshake->outgoing_hs_len = ssl->out_msglen;
+                ssl->handshake->outgoing_hs_offset = 0;
+                /* TLS 1.3 handlers advance state after preparing a message.
+                 * Send it in ssl_prepare_handshake_step, without rerunning
+                 * the handler or hashing/signing the message a second time. */
+                return 0;
+            }
+        }
+#endif
