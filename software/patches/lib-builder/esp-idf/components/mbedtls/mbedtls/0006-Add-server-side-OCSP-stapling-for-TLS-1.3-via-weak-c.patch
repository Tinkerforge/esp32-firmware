From 501ce7b53b87093cfbb6bfb19c616f1a3691d038 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Olaf=20L=C3=BCke?= <olaf@tinkerforge.com>
Date: Tue, 25 Aug 2026 17:31:11 +0200
Subject: [PATCH] Add server side OCSP stapling for TLS 1.3 via weak callback

RFC 8446 4.4.2.1: when the client sends a status_request extension the
server staples a DER OCSPResponse into the CertificateEntry extensions
of the Certificate message, one per chain certificate, provided by the
weakly linked mbedtls_ssl_tls13_ocsp_response_cb hook. The default hook
staples nothing, so behavior is unchanged unless an application defines
a strong override.
---
 library/ssl_tls13_generic.c | 64 ++++++++++++++++++++++++++++++++++---
 1 file changed, 60 insertions(+), 4 deletions(-)

diff --git a/library/ssl_tls13_generic.c b/library/ssl_tls13_generic.c
index b6d0978..fd787cb 100644
--- a/library/ssl_tls13_generic.c
+++ b/library/ssl_tls13_generic.c
@@ -756,6 +756,29 @@ cleanup:
  *        CertificateEntry certificate_list<0..2^24-1>;
  *    } Certificate;
  */
+/* Weakly linked hook for server side OCSP stapling (RFC 8446 4.4.2.1).
+ * Called for every own chain certificate (index 0 is the leaf) while the
+ * Certificate message is written, but only when the peer sent a
+ * status_request extension in its ClientHello. An application provided
+ * strong definition returns 0 and a DER encoded OCSPResponse to staple
+ * into the CertificateEntry extensions. The default staples nothing. */
+static int __mbedtls_ssl_tls13_ocsp_response_cb_default(mbedtls_ssl_context *ssl,
+                                                        size_t index,
+                                                        const unsigned char **der,
+                                                        size_t *der_len)
+{
+    (void) ssl;
+    (void) index;
+    (void) der;
+    (void) der_len;
+    return -1;
+}
+int mbedtls_ssl_tls13_ocsp_response_cb(mbedtls_ssl_context *ssl,
+                                       size_t index,
+                                       const unsigned char **der,
+                                       size_t *der_len)
+__attribute__((weak, alias("__mbedtls_ssl_tls13_ocsp_response_cb_default")));
+
 MBEDTLS_CHECK_RETURN_CRITICAL
 static int ssl_tls13_write_certificate_body(mbedtls_ssl_context *ssl,
                                             unsigned char *buf,
@@ -769,6 +792,11 @@ static int ssl_tls13_write_certificate_body(mbedtls_ssl_context *ssl,
     unsigned char certificate_request_context_len =
         ssl->handshake->certificate_request_context_len;
     unsigned char *p_certificate_list_len;
+    size_t cert_index = 0;
+    int staple_allowed =
+        ssl->conf->endpoint == MBEDTLS_SSL_IS_SERVER &&
+        (ssl->handshake->received_extensions &
+         MBEDTLS_SSL_EXT_MASK(STATUS_REQUEST)) != 0;
 
 
     /* ...
@@ -794,6 +822,9 @@ static int ssl_tls13_write_certificate_body(mbedtls_ssl_context *ssl,
 
     while (crt != NULL) {
         size_t cert_data_len = crt->raw.len;
+        const unsigned char *ocsp_der = NULL;
+        size_t ocsp_der_len = 0;
+        size_t extensions_len = 0;
 
         MBEDTLS_SSL_CHK_BUF_PTR(p, end, cert_data_len + 3 + 2);
         MBEDTLS_PUT_UINT24_BE(cert_data_len, p, 0);
@@ -803,11 +834,36 @@ static int ssl_tls13_write_certificate_body(mbedtls_ssl_context *ssl,
         p += cert_data_len;
         crt = crt->next;
 
-        /* Currently, we don't have any certificate extensions defined.
-         * Hence, we are sending an empty extension with length zero.
-         */
-        MBEDTLS_PUT_UINT16_BE(0, p, 0);
+        /* RFC 8446 4.4.2.1: staple an OCSP response into the
+         * CertificateEntry extensions when the client requested the
+         * certificate status and the hook provides a response. */
+        if (staple_allowed &&
+            mbedtls_ssl_tls13_ocsp_response_cb(ssl, cert_index,
+                                               &ocsp_der, &ocsp_der_len) == 0 &&
+            ocsp_der != NULL && ocsp_der_len > 0 && ocsp_der_len <= 0xFFFFFF) {
+            /* extension_type(2) + extension_data_len(2) +
+             * CertificateStatus: status_type(1) + response_len(3) + response */
+            extensions_len = 2 + 2 + 1 + 3 + ocsp_der_len;
+        }
+
+        MBEDTLS_SSL_CHK_BUF_PTR(p, end, 2 + extensions_len);
+        MBEDTLS_PUT_UINT16_BE(extensions_len, p, 0);
         p += 2;
+
+        if (extensions_len > 0) {
+            MBEDTLS_PUT_UINT16_BE(MBEDTLS_TLS_EXT_STATUS_REQUEST, p, 0);
+            MBEDTLS_PUT_UINT16_BE(extensions_len - 4, p, 2);
+            p += 4;
+            *p++ = 1; /* CertificateStatusType ocsp */
+            MBEDTLS_PUT_UINT24_BE(ocsp_der_len, p, 0);
+            p += 3;
+            memcpy(p, ocsp_der, ocsp_der_len);
+            p += ocsp_der_len;
+            ssl->handshake->sent_extensions |=
+                MBEDTLS_SSL_EXT_MASK(STATUS_REQUEST);
+        }
+
+        cert_index++;
     }
 
     MBEDTLS_PUT_UINT24_BE(p - p_certificate_list_len - 3,
-- 
2.43.0

